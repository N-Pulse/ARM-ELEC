	)
	(text "Resets the STM32 to its base config. To reset, connect NRST TestPoint to GND.\n- 100nF capacitor to prevent high dV/dt inductive spike disruptions (due to motors)\n- 47Ohm resistor to limit peak current discharge when line pulled low\n- 10kOhm pull-up resistor to complement the STM32's internal 40kOhms\n- ESD diode PESD5V to protect the STM32 against \n  static discharge through RESET button."
		(exclude_from_sim no)
		(at 22.225 169.545 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
				(color 0 132 132 1)
			)
			(justify left)
		)
		(uuid "9cdbf448-5a27-4858-b9d0-e46174fb0ac7")
	)
