	(text "6-channel force resistive sensor (FSR) voltage buffer (5x finger pressure, 1x wrist flexion). \nEach FSR (sensor_x) forms a voltage divider with two series resistor (R_x & R_x+1); divider \nmidpoint feeds the op-amp non-inverting input in unity-gain buffer configuration. \nBuffered by TSX634IQ4T (quad) + TSX632IQ2T (dual); unused channels (NC) terminated per datasheet.\nR_x values are placeholders - final values TBD via bench characterization against each FSR's \nforce/resistance curve."
		(exclude_from_sim no)
		(at 150.495 99.695 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 132 132 1)
			)
			(justify left)
		)
		(uuid "a5b4caa9-7ab0-4b52-83e1-6b90d3beb646")
	)
